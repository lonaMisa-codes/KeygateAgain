# ======================
# API
# ======================
PORT=3000

# Long random string (min 32 chars) - used for admin endpoints + response signing
ADMIN_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Optional: extra secret for free key endpoint (recommended)
FREE_KEY_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING

# Max free keys one IP can generate per 24h
FREE_KEYS_PER_IP_PER_DAY=3

# How many seconds a verify request timestamp is allowed to be off (anti-replay)
MAX_TIMESTAMP_DRIFT=30

# ======================
# DISCORD BOT
# ======================
DISCORD_TOKEN=YOUR_BOT_TOKEN
GUILD_ID=YOUR_SERVER_ID
ROLE_ID=KEY_MANAGER_ROLE_ID
API_URL=http://localhost:3000
